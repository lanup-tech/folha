# ============================================================
# NobriPonto Analytics — variáveis de ambiente
# Copie para .env.local (app) e preencha. NUNCA versionar o .env.local.
# ============================================================

# ---------- Supabase ----------
# Projeto: https://supabase.com/dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: usado APENAS no servidor (cargas API/RPA). Não expor no front.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- API do ponto (Nobriponto / base Lanup) ----------
NOBRIPONTO_API_URL=
NOBRIPONTO_API_TOKEN=
# Se a autenticação for por usuário/senha:
NOBRIPONTO_API_USER=
NOBRIPONTO_API_PASSWORD=

# ---------- RPA (roda na VPS, usa o mesmo .env lá) ----------
# Credenciais de acesso à interface web do ponto para os relatórios sem API
RPA_PONTO_URL=
RPA_PONTO_USER=
RPA_PONTO_PASSWORD=
# Cron sugerido na VPS: 0 6 * * * (diário 06:00)

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
