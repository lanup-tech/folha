# ============================================================
# NobriPonto Analytics — variáveis de ambiente
# Copie para .env.local (app) e preencha. NUNCA versionar o .env.local.
# ============================================================

# ---------- Supabase ----------
# Projeto: https://supabase.com/dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: usado APENAS no servidor (cargas API/RPA). Não expor no front.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- API do ponto (EzPoint Web — base Nobriponto/Lanup) ----------
# Doc: Documentação_API_EzPointWeb_v1.5. Usuário/senha da API são cadastrados
# no módulo Admin do EzPoint Web (não é o login da tela).
EZPOINT_API_URL=https://api.ezpointweb.com.br/ezweb-ws
EZPOINT_EMPRESA=
EZPOINT_USUARIO=
EZPOINT_SENHA=

# ---------- RPA (roda na VPS, usa o mesmo .env lá) ----------
# Acesso à interface web do ponto — só para o relatório Abono de Faltas,
# que não tem endpoint de leitura na API v1.5
RPA_PONTO_URL=
RPA_PONTO_USER=
RPA_PONTO_PASSWORD=
# Cron sugerido na VPS: 0 6 * * * (diário 06:00)

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
